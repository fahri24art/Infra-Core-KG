// --- DEPARTMENTS ---





router.get('/departments', async (req, res) => {


  try {


    const result = await db.raw(`


      SELECT d.id, d.name, d.monthly_quota_bw, d.monthly_quota_color, d.created_at,


             COALESCE(SUM(q.current_usage_bw), 0) as current_usage_bw,


             COALESCE(SUM(q.current_usage_color), 0) as current_usage_color,


             COUNT(q.id) as device_count


      FROM ricoh_departments d


      LEFT JOIN ricoh_device_quotas q ON d.id = q.department_id


      GROUP BY d.id


      ORDER BY d.name ASC


    `);


    res.json(result.rows || result);


  } catch (err) {


    res.status(500).json({ error: err.message });


  }


});





