const snmp = require('net-snmp');

const oids = {
  model: "1.3.6.1.2.1.25.3.2.1.3.1",
  serial: "1.3.6.1.2.1.43.5.1.1.17.1",
  tonerBlack: "1.3.6.1.2.1.43.11.1.1.9.1.1",
  tonerCyan: "1.3.6.1.2.1.43.11.1.1.9.1.2",
  tonerMagenta: "1.3.6.1.2.1.43.11.1.1.9.1.3",
  tonerYellow: "1.3.6.1.2.1.43.11.1.1.9.1.4",
  counterTotal: "1.3.6.1.4.1.367.3.2.1.2.19.1.0",   // Total pages (all)
  counterBW:    "1.3.6.1.4.1.367.3.2.1.2.19.2.0",   // BW pages - Ricoh MP series
  counterColor: "1.3.6.1.4.1.367.3.2.1.2.19.4.0"    // Color pages - Ricoh MP series
};

const pollDevice = (ip) => {
  return new Promise((resolve, reject) => {
    const session = snmp.createSession(ip, "public");
    const oidList = Object.values(oids);

    session.get(oidList, (error, varbinds) => {
      if (error) {
        session.close();
        return reject(error);
      }

      const results = {};
      Object.keys(oids).forEach((key, index) => {
        if (snmp.isVarbindError(varbinds[index])) {
          results[key] = null;
        } else {
          results[key] = varbinds[index].value.toString();
        }
      });

      session.close();
      resolve(results);
    });
  });
};

const calculateDelta = (currentStats, previousStats) => {
  const delta = {
    bw: parseInt(currentStats.counterBW || 0) - parseInt(previousStats.counterBW || 0),
    color: parseInt(currentStats.counterColor || 0) - parseInt(previousStats.counterColor || 0),
    total: parseInt(currentStats.counterTotal || 0) - parseInt(previousStats.counterTotal || 0)
  };
  return delta;
};

module.exports = {
  pollDevice,
  calculateDelta
};
